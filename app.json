{
  "expo": {
    "name": "BloopIQ",
    "slug": "guessr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "guessr",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": {
        "light": "./assets/branding/app-icon.png",
        "dark": "./assets/branding/ios-icon-dark.png",
        "tinted": "./assets/branding/ios-icon-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.guessr.game"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D9CDB",
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "backgroundImage": "./assets/branding/android-adaptive-background.png",
        "monochromeImage": "./assets/branding/android-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guessr.game",
      "icon": "./assets/branding/app-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D9CDB",
          "image": "./assets/branding/splash-ios.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/branding/splash-android.png",
            "imageWidth": 288
          },
          "ios": {
            "image": "./assets/branding/splash-ios.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
