{
  "name": "bloopiq",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/ui": "~58.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev-client": "expo start --dev-client",
    "android:dev": "expo run:android",
    "ios:dev": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:branding",
    "generate:sounds": "node ./scripts/generate-sounds.mjs",
    "prepare:quiz-assets": "node ./scripts/prepare-quiz-assets.mjs",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "generate:branding": "node ./scripts/generate-brand-assets.mjs",
    "check:branding": "node ./scripts/check-brand-assets.mjs",
    "preflight": "npm run check && npx expo-doctor",
    "build:android": "npm run preflight && npx eas-cli build --platform android --profile development",
    "build:android:qa": "npm run preflight && npx eas-cli build --platform android --profile ads-qa",
    "build:android:production": "npm run preflight && npx eas-cli build --platform android --profile production",
    "build:ios": "npm run preflight && npx eas-cli build --platform ios --profile testflight",
    "build:ios:production": "npm run preflight && npx eas-cli build --platform ios --profile production",
    "deploy:ios:testflight": "npm run preflight && npx eas-cli build --platform ios --profile testflight --auto-submit"
  },
  "private": true
}
